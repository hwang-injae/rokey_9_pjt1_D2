# 놓기. station 이 SPONGE_BED_B / SPONGE_BED_C 이면 "안착 놓기":
#   용기를 쥔 채 홈 위에서 순응 하강 → 깊이+힘으로 홈에 들어갔는지 판정 → 안 들어가면 Move Periodic 으로 탐색
#   → 들어가면 놓고 후퇴(OK) / 한도 초과면 들고 후퇴(SEAT_FAIL).   그 외 station 은 상공 → 하강 → 놓기 → 후퇴.
string station      # SPONGE_BED_B / SPONGE_BED_C / ISOLATE / WASTE ...
---
bool ok
string code         # OK / SEAT_FAIL / FORCE_LIMIT / TIMEOUT / ROBOT_ERROR
float32 offset_mm   # 안착 놓기에서 탐색으로 보정된 거리 (일반 놓기는 0)
