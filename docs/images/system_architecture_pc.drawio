<mxfile host="app.diagrams.net"><diagram name="시스템 아키텍처(PC)" id="arch"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1180" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="pcA" value="&lt;b&gt;PC-A  로봇 제어 PC  (통합 실행 시 필수)&lt;/b&gt;&lt;br&gt;Ubuntu 24.04 · ROS 2 Jazzy · ROS_DOMAIN_ID=60 · IP 192.168.1.__ (컨트롤러와 같은 유선망)" style="fillColor=#FFFFFF;strokeColor=#222222;fontFamily=Helvetica;fontSize=11;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;fontStyle=1;fontSize=12;rounded=1;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="700" height="650" as="geometry"/></mxCell><mxCell id="wsdsr" value="&lt;b&gt;ws_dsr  (강사 배포 드라이버 워크스페이스 — 수정하지 않음, 먼저 source)&lt;/b&gt;" style="fillColor=#F3F3F3;strokeColor=#999999;fontFamily=Helvetica;fontSize=11;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;fontStyle=1;fontSize=12;rounded=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="660" height="120" as="geometry"/></mxCell><mxCell id="dsrctl" value="&lt;b&gt;dsr_controller2  (네임스페이스 /dsr01)&lt;/b&gt;&lt;br&gt;ros2 launch m0609_rg2_bringup bringup.launch.py&lt;br&gt;mode:=real host:=192.168.1.100 port:=12345 model:=m0609" style="fillColor=#EFEFEF;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;whiteSpace=wrap;html=1;rounded=1;" vertex="1" parent="1"><mxGeometry x="80" y="170" width="350" height="68" as="geometry"/></mxCell><mxCell id="dsrapi" value="&lt;b&gt;DSR_ROBOT2 파이썬 API (DR_init)&lt;/b&gt;&lt;br&gt;movej / movel / set_desired_force&lt;br&gt;get_workpiece_weight / set_digital_output" style="fillColor=#EFEFEF;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;whiteSpace=wrap;html=1;rounded=1;" vertex="1" parent="1"><mxGeometry x="450" y="170" width="250" height="68" as="geometry"/></mxCell><mxCell id="wsour" value="&lt;b&gt;rokey_pjt01_ws  (우리 저장소 rokey_9_pjt1_D2)&lt;/b&gt;&lt;br&gt;docs/ + src/ · build·install·log 는 .gitignore" style="fillColor=#F3F3F3;strokeColor=#999999;fontFamily=Helvetica;fontSize=11;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;fontStyle=1;fontSize=12;rounded=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="60" y="270" width="660" height="430" as="geometry"/></mxCell><mxCell id="common" value="&lt;b&gt;cobot_common  (라이브러리, 노드 아님 · 한석형)  — 두산 API를 감싼 공용 로봇 함수 모음&lt;/b&gt;&lt;br&gt;move_to · grip · release · weigh · force_on/off · contact_down · periodic_search · safe_retreat" style="fillColor=#CFE2F3;strokeColor=#3D85C6;fontFamily=Helvetica;fontSize=11;whiteSpace=wrap;html=1;rounded=1;" vertex="1" parent="1"><mxGeometry x="80" y="310" width="620" height="52" as="geometry"/></mxCell><mxCell id="f1" value="&lt;b&gt;f1_node  (f1_handling)&lt;/b&gt;&lt;br&gt;한석형 · 파지·이송·적재 · srv:&lt;br&gt;/f1/pick /f1/place /f1/move_to&lt;br&gt;/f1/tool /f1/rack_place /f1/home&lt;br&gt;f1.yaml (좌표·폭·힘·속도)" style="fillColor=#CFE2F3;strokeColor=#3D85C6;fontFamily=Helvetica;fontSize=11;whiteSpace=wrap;html=1;rounded=1;" vertex="1" parent="1"><mxGeometry x="80" y="392" width="196" height="88" as="geometry"/></mxCell><mxCell id="f2" value="&lt;b&gt;f2_node  (f2_sense_flow)&lt;/b&gt;&lt;br&gt;민범진 · 무게·털기·헹굼 · srv:&lt;br&gt;/f2/weigh /f2/leftover_loop&lt;br&gt;/f2/shake /f2/dip&lt;br&gt;f2.yaml (기준 무게·임계·진폭)" style="fillColor=#D9EAD3;strokeColor=#6AA84F;fontFamily=Helvetica;fontSize=11;whiteSpace=wrap;html=1;rounded=1;" vertex="1" parent="1"><mxGeometry x="292" y="392" width="196" height="88" as="geometry"/></mxCell><mxCell id="f3" value="&lt;b&gt;f3_node  (f3_wipe)&lt;/b&gt;&lt;br&gt;박진용 · 접촉 닦기 · srv:&lt;br&gt;/f3/seat /f3/soap /f3/wipe&lt;br&gt;f3.yaml (목표 힘·상한·궤적)" style="fillColor=#FCE5CD;strokeColor=#E69138;fontFamily=Helvetica;fontSize=11;whiteSpace=wrap;html=1;rounded=1;" vertex="1" parent="1"><mxGeometry x="504" y="392" width="196" height="88" as="geometry"/></mxCell><mxCell id="flow" value="&lt;b&gt;flow_node (f2_sense_flow) · 민범진 — 유일한 호출자(상태 머신)&lt;/b&gt;&lt;br&gt;srv 제공: /flow/start /flow/stop /flow/resume (std_srvs/Trigger)&lt;br&gt;pub: /flow/state (2 Hz) · /flow/event (용기당 1건)&lt;br&gt;flow.yaml (슬롯 순서 · 실패 정책 · 랙 배정)" style="fillColor=#D9EAD3;strokeColor=#6AA84F;fontFamily=Helvetica;fontSize=11;whiteSpace=wrap;html=1;rounded=1;" vertex="1" parent="1"><mxGeometry x="190" y="522" width="400" height="92" as="geometry"/></mxCell><mxCell id="csv" value="&lt;b&gt;records.csv&lt;/b&gt;&lt;br&gt;(PC-A 로컬)" style="shape=cylinder3;fillColor=#FFF2CC;strokeColor=#BF9000;fontFamily=Helvetica;fontSize=11;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="610" y="636" width="90" height="52" as="geometry"/></mxCell><mxCell id="msgs" value="&lt;b&gt;cobot_msgs  (민범진 정본 관리)&lt;/b&gt;&lt;br&gt;srv 12종 + msg 2종 (IRD)  — PC-A·PC-B 양쪽에서 빌드" style="fillColor=#D9EAD3;strokeColor=#6AA84F;fontFamily=Helvetica;fontSize=11;whiteSpace=wrap;html=1;rounded=1;" vertex="1" parent="1"><mxGeometry x="80" y="636" width="230" height="52" as="geometry"/></mxCell><mxCell id="bring" value="&lt;b&gt;rewash_bringup  (민범진)&lt;/b&gt;&lt;br&gt;rewash.launch.py / rewash_mock.launch.py" style="fillColor=#D9EAD3;strokeColor=#6AA84F;fontFamily=Helvetica;fontSize=11;whiteSpace=wrap;html=1;rounded=1;" vertex="1" parent="1"><mxGeometry x="330" y="636" width="260" height="52" as="geometry"/></mxCell><mxCell id="sw" value="&lt;b&gt;스위치 / 공유기&lt;/b&gt;&lt;br&gt;192.168.1.0/24&lt;br&gt;(유선 권장)" style="fillColor=#EFEFEF;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;whiteSpace=wrap;html=1;rounded=1;" vertex="1" parent="1"><mxGeometry x="780" y="330" width="120" height="70" as="geometry"/></mxCell><mxCell id="pcB" value="&lt;b&gt;PC-B  HMI PC  (통합 실행 시 권장 · 없으면 PC-A 1대로 통합 가능)&lt;/b&gt;&lt;br&gt;Ubuntu 24.04 · ROS 2 Jazzy · ROS_DOMAIN_ID=60 · IP 192.168.1.__ (PC-A와 같은 스위치)" style="fillColor=#FFFFFF;strokeColor=#222222;fontFamily=Helvetica;fontSize=11;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;fontStyle=1;fontSize=12;rounded=1;" vertex="1" parent="1"><mxGeometry x="940" y="70" width="480" height="380" as="geometry"/></mxCell><mxCell id="wsourB" value="&lt;b&gt;rokey_pjt01_ws  (같은 저장소 clone — cobot_msgs + f4_hmi 만 빌드)&lt;/b&gt;" style="fillColor=#F3F3F3;strokeColor=#999999;fontFamily=Helvetica;fontSize=11;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;fontStyle=1;fontSize=12;rounded=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="960" y="130" width="440" height="200" as="geometry"/></mxCell><mxCell id="msgsB" value="&lt;b&gt;cobot_msgs&lt;/b&gt;&lt;br&gt;(FlowState·FlowEvent 해석용)" style="fillColor=#D9EAD3;strokeColor=#6AA84F;fontFamily=Helvetica;fontSize=11;whiteSpace=wrap;html=1;rounded=1;" vertex="1" parent="1"><mxGeometry x="980" y="170" width="180" height="50" as="geometry"/></mxCell><mxCell id="bridge" value="&lt;b&gt;hmi_bridge  (f4_hmi) · 황인재&lt;/b&gt;&lt;br&gt;FastAPI + rclpy · 포트 8000&lt;br&gt;sub  /flow/state  /flow/event&lt;br&gt;cli  /flow/start|stop|resume&lt;br&gt;REST /api/*   WS /ws/state&lt;br&gt;SQLite 기록 (events 표)" style="fillColor=#D9D2E9;strokeColor=#8E7CC3;fontFamily=Helvetica;fontSize=11;whiteSpace=wrap;html=1;rounded=1;" vertex="1" parent="1"><mxGeometry x="1180" y="170" width="200" height="140" as="geometry"/></mxCell><mxCell id="fake" value="&lt;b&gt;fake_state_pub  (개발용)&lt;/b&gt;&lt;br&gt;/flow/state·/flow/event 를&lt;br&gt;시나리오대로 발행 — 로봇 불필요" style="fillColor=#D9D2E9;strokeColor=#8E7CC3;fontFamily=Helvetica;fontSize=11;whiteSpace=wrap;html=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="980" y="240" width="180" height="70" as="geometry"/></mxCell><mxCell id="db" value="&lt;b&gt;rewash.db&lt;/b&gt;&lt;br&gt;(SQLite)" style="shape=cylinder3;fillColor=#FFF2CC;strokeColor=#BF9000;fontFamily=Helvetica;fontSize=11;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1300" y="350" width="100" height="80" as="geometry"/></mxCell><mxCell id="browser" value="&lt;b&gt;브라우저 (Chrome) — PC-B 화면 또는 LAN 태블릿&lt;/b&gt;&lt;br&gt;http://&amp;lt;PC-B IP&amp;gt;:8000&lt;br&gt;시작·정지·재개 / 단계·슬롯·수량 / 오류 / 이력" style="fillColor=#D9D2E9;strokeColor=#8E7CC3;fontFamily=Helvetica;fontSize=11;whiteSpace=wrap;html=1;rounded=1;" vertex="1" parent="1"><mxGeometry x="960" y="350" width="320" height="80" as="geometry"/></mxCell><mxCell id="cell" value="&lt;b&gt;로봇 셀&lt;/b&gt;" style="fillColor=#FFFFFF;strokeColor=#222222;fontFamily=Helvetica;fontSize=11;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;fontStyle=1;fontSize=12;rounded=1;" vertex="1" parent="1"><mxGeometry x="940" y="500" width="480" height="220" as="geometry"/></mxCell><mxCell id="ctrl" value="&lt;b&gt;M0609 컨트롤러 (제어함)&lt;/b&gt;&lt;br&gt;IP 192.168.1.100 · TCP 12345&lt;br&gt;Dart Platform 2.12.1&lt;br&gt;제어권: ROS ↔ 티치펜던트 동시 금지" style="fillColor=#EFEFEF;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;whiteSpace=wrap;html=1;rounded=1;" vertex="1" parent="1"><mxGeometry x="960" y="540" width="210" height="90" as="geometry"/></mxCell><mxCell id="arm" value="&lt;b&gt;M0609 협동로봇 (6축 · 6 kg · 900 mm)&lt;/b&gt;&lt;br&gt;관절 토크 센서 → 하중·힘 측정" style="fillColor=#EFEFEF;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;whiteSpace=wrap;html=1;rounded=1;" vertex="1" parent="1"><mxGeometry x="1200" y="540" width="200" height="50" as="geometry"/></mxCell><mxCell id="rg2" value="&lt;b&gt;OnRobot RG2 그리퍼&lt;/b&gt;&lt;br&gt;파지 폭 0~110 mm · 폭 피드백&lt;br&gt;Compute Box 설정 웹 192.168.1.1&lt;br&gt;DO1/DO2 ← 잡기/놓기 · DI1/DI2 → 완료" style="fillColor=#EFEFEF;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;whiteSpace=wrap;html=1;rounded=1;" vertex="1" parent="1"><mxGeometry x="1200" y="615" width="200" height="90" as="geometry"/></mxCell><mxCell id="dev" value="&lt;b&gt;개발 중 구성 (9/17~9/22)  — 4대 각자, 로봇 없이&lt;/b&gt;&lt;br&gt;&lt;br&gt;PC1 한석형: sodvir(Virtual) + f1_node&lt;br&gt;    + rig_f1 (단독 시험)&lt;br&gt;PC2 민범진: sodvir + f2_node + flow_node&lt;br&gt;    + mock_f1_f3 (가짜 F1·F3)&lt;br&gt;PC3 박진용: sodvir + f3_node + rig_f3&lt;br&gt;PC4 황인재: fake_state_pub + hmi_bridge&lt;br&gt;    + 브라우저 (ROS 드라이버 불필요)&lt;br&gt;&lt;br&gt;실기 슬롯(1대 로봇)은 docs/04 로봇 슬롯 표&lt;br&gt;Virtual 에는 힘·무게·접촉이 없음&lt;br&gt;→ 로직은 Virtual/mock, 임계값은 실기" style="fillColor=#F3F3F3;strokeColor=#999999;fontFamily=Helvetica;fontSize=11;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;fontStyle=1;fontSize=12;rounded=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1450" y="70" width="250" height="380" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;범례&lt;/b&gt;&lt;br&gt;&lt;br&gt;실선 = 서비스 호출 (요청→응답)&lt;br&gt;점선 = 토픽 (발행→구독)&lt;br&gt;굵은 선 = 네트워크·물리 연결&lt;br&gt;&lt;br&gt;파랑 F1 한석형 · 초록 F2 민범진&lt;br&gt;주황 F3 박진용 · 보라 F4 황인재&lt;br&gt;회색 = 두산·OnRobot·외부&lt;br&gt;&lt;br&gt;IP 빈칸(__)은 실측 후 기입" style="fillColor=#F3F3F3;strokeColor=#999999;fontFamily=Helvetica;fontSize=11;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=6;fontStyle=1;fontSize=12;rounded=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="1450" y="500" width="250" height="220" as="geometry"/></mxCell><mxCell id="e0" value="srv /f1/*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;strokeWidth=1.5;" edge="1" parent="1" source="flow" target="f1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="srv /f2/*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;strokeWidth=1.5;" edge="1" parent="1" source="flow" target="f2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="srv /f3/*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;strokeWidth=1.5;" edge="1" parent="1" source="flow" target="f3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;strokeColor=#777777;" edge="1" parent="1" source="f1" target="common"><mxGeometry relative="1" as="geometr