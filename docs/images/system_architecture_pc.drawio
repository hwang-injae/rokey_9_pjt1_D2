<mxfile host="app.diagrams.net"><diagram name="시스템 아키텍처(PC)" id="arch"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1040" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="pcA" value="&lt;b&gt;PC-A  로봇 제어 PC   ·  Ubuntu 24.04 · ROS 2 Jazzy · ROS_DOMAIN_ID=60 · 유선 192.168.1.x&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#222222;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="84" width="1060" height="880" as="geometry"/></mxCell><mxCell id="pcB" value="&lt;b&gt;PC-B  HMI PC  · DOMAIN 60&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#222222;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1440" y="84" width="290" height="420" as="geometry"/></mxCell><mxCell id="cell" value="&lt;b&gt;로봇 셀&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#222222;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1160" y="560" width="570" height="404" as="geometry"/></mxCell><mxCell id="flow" value="&lt;b&gt;flow_node&lt;/b&gt;&lt;br&gt;f2_sense_flow · 민범진&lt;br&gt;유일한 호출자 · 상태 머신" style="whiteSpace=wrap;html=1;fontSize=11;fillColor=#D9EAD3;strokeColor=#6AA84F;rounded=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="430" y="124" width="260" height="70" as="geometry"/></mxCell><mxCell id="f1" value="&lt;b&gt;f1_node&lt;/b&gt;&lt;br&gt;f1_handling · 한석형&lt;br&gt;탐색 파지 · 안착 놓기 · 이송 · 툴 · 팔레트 적재" style="whiteSpace=wrap;html=1;fontSize=11;fillColor=#CFE2F3;strokeColor=#3D85C6;rounded=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="70" y="360" width="280" height="84" as="geometry"/></mxCell><mxCell id="f2" value="&lt;b&gt;f2_node&lt;/b&gt;&lt;br&gt;f2_sense_flow · 민범진&lt;br&gt;무게 · 잔반 폐루프 · 털기 · 헹굼" style="whiteSpace=wrap;html=1;fontSize=11;fillColor=#D9EAD3;strokeColor=#6AA84F;rounded=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="420" y="360" width="280" height="84" as="geometry"/></mxCell><mxCell id="f3" value="&lt;b&gt;f3_node&lt;/b&gt;&lt;br&gt;f3_wipe · 박진용&lt;br&gt;세제 담금 · 그릇 닦기 · 컵 닦기" style="whiteSpace=wrap;html=1;fontSize=11;fillColor=#FCE5CD;strokeColor=#E69138;rounded=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="770" y="360" width="280" height="84" as="geometry"/></mxCell><mxCell id="dsr" value="&lt;b&gt;dsr_controller2  (/dsr01)&lt;/b&gt;&lt;br&gt;두산 드라이버 · ws_dsr (수정 안 함)&lt;br&gt;m0609_rg2_bringup bringup.launch.py" style="whiteSpace=wrap;html=1;fontSize=11;fillColor=#EFEFEF;strokeColor=#666666;rounded=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="400" y="690" width="320" height="78" as="geometry"/></mxCell><mxCell id="rviz" value="&lt;b&gt;rviz2 · 모니터링 (선택)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=11;fillColor=#EFEFEF;strokeColor=#666666;rounded=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="110" y="830" width="190" height="48" as="geometry"/></mxCell><mxCell id="hmi" value="&lt;b&gt;hmi_bridge&lt;/b&gt;&lt;br&gt;f4_hmi · 황인재&lt;br&gt;설계 중 (F4-00) → DSN-03에서 확정" style="whiteSpace=wrap;html=1;fontSize=11;fillColor=#D9D2E9;strokeColor=#8E7CC3;rounded=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1465" y="150" width="240" height="96" as="geometry"/></mxCell><mxCell id="ctrl" value="&lt;b&gt;M0609 컨트롤러&lt;/b&gt;&lt;br&gt;192.168.1.100 · TCP 12345&lt;br&gt;Dart Platform 2.12.1" style="whiteSpace=wrap;html=1;fontSize=11;fillColor=#EFEFEF;strokeColor=#666666;rounded=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1190" y="620" width="240" height="80" as="geometry"/></mxCell><mxCell id="arm" value="&lt;b&gt;M0609 협동로봇&lt;/b&gt;&lt;br&gt;6축 · 6 kg · 관절 토크 센서" style="whiteSpace=wrap;html=1;fontSize=11;fillColor=#EFEFEF;strokeColor=#666666;rounded=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1470" y="620" width="230" height="60" as="geometry"/></mxCell><mxCell id="rg2" value="&lt;b&gt;OnRobot RG2 그리퍼&lt;/b&gt;&lt;br&gt;폭 피드백 0~110 mm&lt;br&gt;설정 웹 192.168.1.1" style="whiteSpace=wrap;html=1;fontSize=11;fillColor=#EFEFEF;strokeColor=#666666;rounded=0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1470" y="740" width="230" height="84" as="geometry"/></mxCell><mxCell id="common" value="&lt;b&gt;cobot_common  (라이브러리 — 노드 아님 · 박진용)&lt;/b&gt;&lt;br&gt;bootstrap.py: init(node) · spin(node) — 기능 노드 프로세스마다 DSR 전용 노드(&amp;lt;노드&amp;gt;_dsr) 1개 + 자체 실행기. rclpy.spin() 금지 (TS-01, SDD §3.2)&lt;br&gt;robot.py: move_to · move_rel · grip · grip_level · release · weigh · force_on/off · force_reached · contact_down · periodic_search · safe_retreat&lt;br&gt;config.py → config/cell.yaml (공용 좌표·속도·프리셋 · 한석형) + config/params.yaml (f1 · f2 · f3 · flow · hmi 절 — 자기 절만 수정)" style="whiteSpace=wrap;html=1;fontSize=11;fillColor=#F7F7F7;strokeColor=#777777;dashed=1;rounded=1;" vertex="1" parent="1"><mxGeometry x="70" y="502" width="980" height="84" as="geometry"/></mxCell><mxCell id="csv" value="&lt;b&gt;records.csv&lt;/b&gt;&lt;br&gt;용기당 1행 (PC-A 로컬)" style="shape=cylinder3;whiteSpace=wrap;html=1;fontSize=11;fillColor=#EFEFEF;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="130" y="128" width="180" height="56" as="geometry"/></mxCell><mxCell id="web" value="&lt;b&gt;웹 서버 · 브라우저 · DB&lt;/b&gt;&lt;br&gt;&lt;br&gt;(비워 둠)&lt;br&gt;황인재가 설계한 뒤&lt;br&gt;회의에서 함께 채운다" style="whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#8E7CC3;dashed=1;rounded=1;" vertex="1" parent="1"><mxGeometry x="1465" y="280" width="240" height="200" as="geometry"/></mxCell><mxCell id="t_state" value="&lt;b&gt;/flow/state&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF2CC;strokeColor=#BF9000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1140" y="105" width="250" height="60" as="geometry"/></mxCell><mxCell id="t_event" value="&lt;b&gt;/flow/event&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF2CC;strokeColor=#BF9000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1140" y="195" width="250" height="60" as="geometry"/></mxCell><mxCell id="t_joint" value="&lt;b&gt;/dsr01/joint_states&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF2CC;strokeColor=#BF9000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="90" y="700" width="230" height="58" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;범례&lt;/b&gt;&lt;br&gt;&lt;br&gt;□ 사각형 = 노드&lt;br&gt;◯ 타원 = 토픽&lt;br&gt;→ 실선 화살표 = 서비스 호출(요청 방향)&lt;br&gt;     라벨 = 서비스 이름 : 타입&lt;br&gt;⇢ 점선 화살표 = 토픽 publish / subscribe&lt;br&gt;     라벨 = 메시지 타입&lt;br&gt;┄ 점선 상자 = 라이브러리(노드 아님)&lt;br&gt;━ 굵은 선 = 네트워크·물리 연결&lt;br&gt;색: 파랑 F1 · 초록 F2 · 주황 F3 · 보라 F4 · 회색 외부" style="whiteSpace=wrap;html=1;fontSize=11;fillColor=#F7F7F7;strokeColor=#777777;dashed=1;rounded=1;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1140" y="300" width="280" height="214" as="geometry"/></mxCell><mxCell id="e0" value="서비스 호출  flow_node → f1_node&lt;br&gt;/f1/pick : cobot_msgs/srv/F1Pick&lt;br&gt;/f1/place : cobot_msgs/srv/F1Place&lt;br&gt;/f1/move_to : cobot_msgs/srv/F1MoveTo&lt;br&gt;/f1/tool : cobot_msgs/srv/F1Tool&lt;br&gt;/f1/rack_place : cobot_msgs/srv/F1RackPlace" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="flow" target="f1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="480" y="222"/><mxPoint x="210" y="222"/></Array></mxGeometry></mxCell><mxCell id="e1" value="서비스 호출  flow_node → f2_node&lt;br&gt;/f2/weigh : cobot_msgs/srv/F2Weigh&lt;br&gt;/f2/leftover_loop : cobot_msgs/srv/F2LeftoverLoop&lt;br&gt;/f2/shake : cobot_msgs/srv/F2Shake&lt;br&gt;/f2/dip : cobot_msgs/srv/F2Dip" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="flow" target="f2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="서비스 호출  flow_node → f3_node&lt;br&gt;/f3/soap : cobot_msgs/srv/F3Soap&lt;br&gt;/f3/wipe_bowl : cobot_msgs/srv/F3WipeBowl&lt;br&gt;/f3/wipe_cup : cobot_msgs/srv/F3WipeCup" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="flow" target="f3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="640" y="222"/><mxPoint x="910" y="222"/></Array></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;strokeColor=#888888;" edge="1" parent="1" source="f1" target="common"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="파이썬 함수 호출 (import)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;strokeColor=#888888;" edge="1" parent="1" source="f2" target="common"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;strokeColor=#888888;" edge="1" parent="1" source="f3" target="common"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="서비스 호출  (DSR_ROBOT2 API 내부)  cobot_common → dsr_controller2&lt;br&gt;/dsr01/motion/move_joint · move_line : dsr_msgs2/srv/MoveJoint · MoveLine&lt;br&gt;/dsr01/force/task_compliance_ctrl · set_desired_force · release_force · get_workpiece_weight : dsr_msgs2/srv/…&lt;br&gt;/dsr01/io/set_ctrl_box_digital_output · get_ctrl_box_digital_input : dsr_msgs2/srv/…  (RG2 DO1/DO2 · DI1/DI2)&lt;br&gt;※ 정확한 이름·타입은 두산 ROS 2 매뉴얼(jazzy)로 확인 후 확정" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="common" target="dsr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="CSV 기록" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;strokeColor=#888888;" edge="1" parent="1" source="flow" target="csv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="publish · cobot_msgs/msg/FlowState · 2 Hz" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;dashed=1;strokeWidth=2;" edge="1" parent="1" source="flow" target="t_state"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="publish · cobot_msgs/msg/FlowEvent · 용기당 1건" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;dashed=1;strokeWidth=2;" edge="1" parent="1" source="flow" target="t_event"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1112" y="178"/><mxPoint x="1112" y="225"/></Array></mxGeometry></mxCell><mxCell id="e10" value="subscribe" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;dashed=1;strokeWidth=2;" edge="1" parent="1" source="t_state" target="hmi"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1428" y="135"/><mxPoint x="1428" y="180"/></Array></mxGeometry></mxCell><mxCell id="e11" value="subscribe" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;dashed=1;strokeWidth=2;" edge="1" parent="1" source="t_event" target="hmi"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="서비스 호출  hmi_bridge → flow_node      /flow/start · /flow/stop · /flow/resume : std_srvs/srv/Trigger" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="hmi" target="flow"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1690" y="70"/><mxPoint x="560" y="70"/></Array></mxGeometry></mxCell><mxCell id="e13" value="publish · sensor_msgs/msg/JointState" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;dashed=1;strokeWidth=2;" edge="1" parent="1" source="dsr" target="t_joint"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="subscribe" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;dashed=1;strokeWidth=2;" edge="1" parent="1" source="t_joint" target="rviz"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="두산 전용 TCP 12345 (DDS 아님) · 유선 192.168.1.x" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;strokeWidth=3;strokeColor=#1155AA;" edge="1" parent="1" source="dsr" target="ctrl"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1130" y="729"/><mxPoint x="1130" y="660"/></Array></mxGeometry></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;strokeWidth=3;strokeColor=#1155AA;" edge="1" parent="1" source="ctrl" target="arm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="DO1/DO2 · DI1/DI2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;strokeWidth=3;strokeColor=#1155AA;" edge="1" parent="1" source="ctrl" target="rg2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1450" y="685"/><mxPoint x="1450" y="782"/></Array></mxGeometry></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;strokeColor=#888888;" edge="1" parent="1" source="hmi" target="web"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="title" value="&lt;b&gt;PreWash-Cell 시스템 아키텍처 (PC 단위) — 노드 □ · 토픽 ◯ · 화살표 라벨 = 서비스/메시지 타입&lt;/b&gt;&lt;br&gt;9/18 DSN-01 회의 반영: PC 2대 · 노드 5개 · flow_node만 호출 · wipe 분리 · seat/home 삭제 · 설정은 config/ 한 폴더.   미확정(DSN-03): 반납 구역 방식 · HMI 설계 · FlowState 필드" style="text;html=1;fontSize=14;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1500" height="50" as="geometry"/></mxCell><mxCell id="note" value="개발 중에는 mock_f1_f3(민범진)이 /f1/* · /f3/* 서비스를, fake_state_pub(황인재)이 /flow/state · /flow/event 를 같은 이름으로 대신 제공한다 → 로봇·남의 코드 없이 개발.   PC-A ↔ PC-B 는 같은 스위치의 DDS(멀티캐스트)." style="text;html=1;fontSize=10;fontColor=#555555;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="980" width="1600" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>