# 탐색 파지: zone_id 구역의 탐색점을 순회하며 파지. 고정 위치(SPONGE_BED_*)는 탐색점 1개.
string zone_id      # RET_B / RET_C / SPONGE_BED_B / SPONGE_BED_C
string kind         # BOWL / CUP
---
bool ok
string code         # OK / EMPTY_ZONE / ROBOT_ERROR
float32 width_mm    # 파지 후 그리퍼 폭
uint8 attempts      # 시도한 탐색점 수
float32 offset_x_mm # 성공한 탐색점 오프셋 (구역 기준점 기준)
float32 offset_y_mm
